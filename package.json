{
  "name": "scrapline",
  "private": true,
  "version": "0.4.0",
  "description": "SCRAPLINE (provisional name) \u2014 top-down 2D multiplayer arena shooter for the browser",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @scrapline/server --filter @scrapline/web dev",
    "dev:server": "pnpm --filter @scrapline/server dev",
    "dev:web": "pnpm --filter @scrapline/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @scrapline/server start",
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "db:generate": "pnpm --filter @scrapline/server db:generate",
    "db:migrate": "pnpm --filter @scrapline/server db:migrate",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e:p2p": "playwright test -c tests/e2e-p2p/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "7.0.2",
    "ws": "^8.22.1"
  }
}
