{
  "name": "@scrapline/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/persistence/migrate-cli.ts",
    "db:migrate:prod": "node dist/persistence/migrate-cli.js",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.26",
    "@colyseus/schema": "^5.0.45",
    "@colyseus/ws-transport": "^0.18.4",
    "@scrapline/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
