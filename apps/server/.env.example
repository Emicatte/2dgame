# Copy to .env (never commit real values). All variables are validated at boot (src/config.ts).
NODE_ENV=development
PORT=2567
HOST=0.0.0.0
# Browser origins allowed by CORS (comma separated). Production: your Vercel domain(s).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# PostgreSQL. Optional in development (falls back to an in-memory store), required in production.
DATABASE_URL=postgres://scrapline:scrapline@localhost:5432/scrapline
# TLS to PostgreSQL: disable (private network only) | verify-full | verify-ca. There is no
# "encrypt without verifying" mode. sslmode=... inside DATABASE_URL is ignored.
DATABASE_SSL=disable
# PEM CA bundle of the database provider (e.g. Scaleway instance certificate). Multi-line or with
# \n escapes. Leave empty to use the system CA store (publicly trusted certificates).
DATABASE_SSL_CA=
# Number of reverse proxies in front of the server (X-Forwarded-For hops to trust for rate limits).
# 0 when clients connect directly; 1 on Render / behind one load balancer.
TRUST_PROXY=0
# 32+ random characters in production, e.g. `openssl rand -base64 48`.
TOKEN_SECRET=
LOG_LEVEL=info
# Seconds to let running matches finish after SIGTERM (keep below the platform kill timeout).
SHUTDOWN_DRAIN_SEC=0
# Exposes /api/debug/rooms and deterministic test spawns. Refused in production.
ENABLE_DEBUG_ROUTES=false
